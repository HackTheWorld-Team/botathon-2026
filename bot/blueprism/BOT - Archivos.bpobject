l</reference><reference>System.Drawing.dll</reference></references><imports><import>System</import><import>System.Drawing</import><import>System.Data</import></imports><language>visualbasic</language><pythondllpath></pythondllpath><pythonenvpath></pythonenvpath><globalcode><![CDATA[]]></globalcode><code><![CDATA[]]></code></stage><stage stageid="beddc89a-99cb-4388-b163-3348000dbd9d" name="Clean Up" type="SubSheetInfo"><subsheetid>6e8517f0-8810-4b9f-8429-974aa4d627d7</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="7bec9d98-4493-4cf3-b112-4b6e03345acf" name="Start" type="Start"><subsheetid>6e8517f0-8810-4b9f-8429-974aa4d627d7</subsheetid><loginhibit /><display x="15" y="-105" /><onsuccess>763ac062-9f88-4940-abd0-65da4ba590c4</onsuccess></stage><stage stageid="763ac062-9f88-4940-abd0-65da4ba590c4" name="End" type="End"><subsheetid>6e8517f0-8810-4b9f-8429-974aa4d627d7</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="e38bd883-e938-4cb0-9515-d7b8010aeaca" name="Listar_XLSX_Entrada" type="SubSheetInfo"><subsheetid>0c93f424-84c9-4276-b176-c05b0703e567</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="0dc3100b-0e71-47b9-8511-9cffda2eba96" name="Start" type="Start"><subsheetid>0c93f424-84c9-4276-b176-c05b0703e567</subsheetid><loginhibit /><display x="0" y="-90" /><inputs><input type="text" name="Carpeta_Entrada" stage="Carpeta_Antrada" /></inputs><onsuccess>e046efab-5452-4bc0-ac44-3af3dfacca18</onsuccess></stage><stage stageid="1d7b34ab-1257-4045-80c1-1f1a76fb9a09" name="Clean Up" type="Note"><subsheetid>6e8517f0-8810-4b9f-8429-974aa4d627d7</subsheetid><narrative>Clean Up Page

This is an optional page where you might choose to perform some finalisation (or "cleanup") tasks as your business object is closed down.

The cleanup action will be called automatically immediately after closing your business object at the end of a business process.

You will not be able to call this action from a business process, nor will it be called at any other time than before the disposal of the business object.</narrative><display x="-180" y="60" w="180" h="230" /></stage><stage stageid="e6181fef-c3da-4362-a327-8a8d34382441" name="Initialise" type="Note"><narrative>Initialise Page

This is an optional page where you might choose to perform some initialisation tasks after your business object is loaded.

The initialise action will be called automatically immediately after loading your business object.

You will not be able to call this action from a business process, nor will it be called at any other time than after the creation of the object.</narrative><display x="-195" y="-45" w="180" h="230" /></stage><stage stageid="f8b49b5d-1d86-4a4a-a37f-b3293d8fb729" name="Carpeta_Antrada" type="Data"><subsheetid>0c93f424-84c9-4276-b176-c05b0703e567</subsheetid><display x="-180" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e4ab00a9-8aa6-407b-970e-dbd99edc3df4" name="archivos" type="Collection"><subsheetid>0c93f424-84c9-4276-b176-c05b0703e567</subsheetid><loginhibit /><display x="135" y="-45" /><datatype>collection</datatype><private /><alwaysinit /><collectioninfo><field name="Nombre" type="text" /><field name="Ruta" type="text" /></collectioninfo></stage><stage stageid="e5d94fb9-97ed-40d0-bd5f-2687ef995a2e" name="Mover_Archivo" type="SubSheetInfo"><subsheetid>8483158b-d386-4a8b-adbd-5344849c3e29</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="9fbfb264-3e00-4b8a-a0fd-122828200c7d" name="Start" type="Start"><subsheetid>8483158b-d386-4a8b-adbd-5344849c3e29</subsheetid><loginhibit /><display x="-210" y="0" /><inputs><input type="text" name="Ruta_Origen" stage="Ruta_Origen" /><input type="text" name="Carpeta_Destino" stage="Carpeta_Destinno" /></inputs><onsuccess>1102b4bb-afd9-4e66-a5c6-6857ff8c43de</onsuccess></stage><stage stageid="0df6f7f0-00f7-428f-ad97-d8f39248eee9" name="End" type="End"><subsheetid>8483158b-d386-4a8b-adbd-5344849c3e29</subsheetid><loginhibit /><display x="-210" y="135" /><outputs><output type="text" name="Ruta_Final" stage="Ruta_Final" /></outputs></stage><stage stageid="99e88257-53a4-4ce7-95ae-f71db4f4d0c6" name="Ruta_Origen" type="Data"><subsheetid>8483158b-d386-4a8b-adbd-5344849c3e29</subsheetid><display x="90" y="-105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bfbce1ee-f78c-432b-bf9f-04f6d4083d91" name="Carpeta_Destinno" type="Data"><subsheetid>8483158b-d386-4a8b-adbd-5344849c3e29</subsheetid><display x="15" y="-60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="1102b4bb-afd9-4e66-a5c6-6857ff8c43de" name="Mover" type="Code"><subsheetid>8483158b-d386-4a8b-adbd-5344849c3e29</subsheetid><loginhibit /><display x="-210" y="60" /><inputs><input type="text" name="Ruta_Origen" expr="[Ruta_Origen]" /><input type="text" name="Carpeta_Destino" expr="[Carpeta_Destinno]" /></inputs><outputs><output type="text" name="Ruta_Final" stage="Ruta_Final" /></outputs><onsuccess>0df6f7f0-00f7-428f-ad97-d8f39248eee9</onsuccess><code><![CDATA[If Not System.IO.Directory.Exists(Carpeta_Destino) Then
    System.IO.Directory.CreateDirectory(Carpeta_Destino)
End If
Dim destino As String = System.IO.Path.Combine(Carpeta_Destino, System.IO.Path.GetFileName(Ruta_Origen))
If System.IO.File.Exists(destino) Then
    System.IO.File.Delete(destino)
End If
System.IO.File.Move(Ruta_Origen, destino)
Ruta_Final = destino]]></code></stage><stage stageid="f56cee4b-1828-4c88-a23b-c24d0f73ba8f" name="Ruta_Final" type="Data"><subsheetid>8483158b-d386-4a8b-adbd-5344849c3e29</subsheetid><display x="-90" y="45" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f27da2b9-e594-4880-b07c-ef100b51d35d" name="Ejecutar_Worker_Y_Leer_Resultado" type="SubSheetInfo"><subsheetid>b34e7cf6-1e18-410c-b650-afeb1be644c8</subsheetid><display x="-240" y="-180" w="150" h="90" /></stage><stage stageid="951998f7-c0f4-4ed2-bc04-f846b7a20eb6" name="Start" type="Start"><subsheetid>b34e7cf6-1e18-410c-b650-afeb1be644c8</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Ruta_Archivo" stage="Ruta_Archivo" /><input type="text" name="Repo_Root" stage="Repo_Root" /></inputs><onsuccess>b6670cac-f41c-4bf8-b8ec-9c274858262a</onsuccess></stage><stage stageid="4295af96-dd9c-4094-b677-4f7dbedd5116" name="End" type="End"><subsheetid>b34e7cf6-1e18-410c-b650-afeb1be644c8</subsheetid><loginhibit /><display x="15" y="90" /><outputs><output type="number" name="ExitCode" stage="ExitCode" /><output type="text" name="Estado" stage="Estado" /><output type="number" name="Lote_ID" stage="Lote_ID" /><output type="number" name="Validos" stage="Validos" fromStage="Validos" /><output type="number" name="Rechazados" stage="Rechazados" fromStage="Rechazados" /><output type="number" name="Duracion_Ms" stage="Duracion_Ms" /><output type="text" name="Fecha_Corrida" stage="Fecha_Corrida" /><output type="text" name="Resumen_Texto" stage="Resumen_Texto" /></outputs></stage><stage stageid="327581a0-80a5-4a72-a7f9-1f166e02e6c5" name="Ruta_Archivo" type="Data"><subsheetid>b34e7cf6-1e18-410c-b650-afeb1be644c8</subsheetid><display x="90" y="-105" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="222a9acc-5065-439e-ab0d-67a5c94f9ab3" name="Repo_Root" type="Data"><subsheetid>b34e7cf6-1e18-410c-b650-afeb1be644c8</subsheetid><display x="120" y="-60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b6670cac-f41c-4bf8-b8ec-9c274858262a" name="Correr Worker Python" type="Code"><subsheetid>b34e7cf6-1e18-410c-b650-afeb1be644c8</subsheetid><loginhibit /><display x="15" y="-15" /><inputs><input type="text" name="Ruta_Archivo" expr="[Ruta_Archivo]" /><input type="text" name="Repo_Root" expr="[Repo_Root]" /></inputs><outputs><output type="number" name="ExitCode" stage="ExitCode" /><output type="text" name="Estado" stage="Estado" /><output type="number" name="Lote_ID" stage="Lote_ID" /><output type="number" name="Validos" stage="Validos" /><output type="number" name="Rechazados" stage="Rechazados" /><output type="number" name="Duracion_Ms" stage="Duracion_Ms" /><output type="text" name="Fecha_Corrida" stage="Fecha_Corrida" /><output type="text" name="Resumen_Texto" stage="Resumen_Texto" /></outputs><onsuccess>4295af96-dd9c-4094-b677-4f7dbedd5116</onsuccess><code><![CDATA[Dim psi As New System.Diagnostics.ProcessStartInfo()
Dim venvPython As String = System.IO.Path.Combine(Repo_Root, ".venv\Scripts\python.exe")
If System.IO.File.Exists(venvPython) Then
    psi.FileName = venvPython
Else
    psi.FileName = "python"
End If
psi.Arguments = "bot/worker.py --entrada " & Chr(34) & Ruta_Archivo & Chr(34) & " --db backend/db.sqlite"
psi.WorkingDirectory = Repo_Root
psi.UseShellExecute = False
psi.CreateNoWindow = True
psi.RedirectStandardOutput = True
psi.RedirectStandardError = True

Dim p As System.Diagnostics.Process = System.Diagnostics.Process.Start(psi)
Dim stdout As String = p.StandardOutput.ReadToEnd()
Dim stderr As String = p.StandardError.ReadToEnd()
p.WaitForExit(300000)
ExitCode = p.ExitCode
Resumen_Texto = stdout & " " & stderr
p.Dispose()

Estado = "ERROR"
Lote_ID = 0
Validos = 0
Rechazados = 0
Duracion_Ms = 0
Fecha_Corrida = ""

Dim jsonPath As String = System.IO.Path.Combine(Repo_Root, "bot\reportes\ultimo_resultado.json")
If System.IO.File.Exists(jsonPath) Then
    Dim json As String = System.IO.File.ReadAllText(jsonPath, System.Text.Encoding.UTF8)
    Dim q As String = Chr(34)
    Dim m As System.Text.RegularExpressions.Match

    m = System.Text.RegularExpressions.Regex.Match(json, q & "estado" & q & "\s*:\s*" & q & "([^" & q & "]+)" & q)
    If m.Success Then Estado = m.Groups(1).Value

    m = System.Text.RegularExpressions.Regex.Match(json, q & "lote_id" & q & "\s*:\s*(\d+)")
    If m.Success Then Lote_ID = System.Decimal.Parse(m.Groups(1).Value)

    m = System.Text.RegularExpressions.Regex.Match(json, q & "validos" & q & "\s*:\s*(\d+)")
    If m.Success Then Validos = System.Decimal.Parse(m.Groups(1).Value)

    m = System.Text.RegularExpressions.Regex.Match(json, q & "rechazados" & q & "\s*:\s*(\d+)")
    If m.Success Then Rechazados = System.Decimal.Parse(m.Groups(1).Value)

    m = System.Text.RegularExpressions.Regex.Match(json, q & "duracion_ms" & q & "\s*:\s*(\d+)")
    If m.Success Then Duracion_Ms = System.Decimal.Parse(m.Groups(1).Value)

    m = System.Text.RegularExpressions.Regex.Match(json, q & "fecha_corrida" & q & "\s*:\s*" & q & "([^" & q & "]+)" & q)
    If m.Success Then Fecha_Corrida = m.Groups(1).Value
End If]]></code></stage><stage stageid="dc87e55d-9c0e-44e5-b7cc-d4c73d00af3e" name="ExitCode" type="Data"><subsheetid>b34e7cf6-1e18-410c-b650-afeb1be644c8</subsheetid><display x="90" y="-15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="62161d05-a304-4778-92db-12bee8e7e702" name="Estado" type="Data"><subsheetid>b34e7cf6-1e18-410c-b650-afeb1be644c8</subsheetid><display x="-135" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="ea50a819-6d16-4692-86f8-0a414394d98f" name="Lote_ID" type="Data"><subsheetid>b34e7cf6-1e18-410c-b650-afeb1be644c8</subsheetid><display x="-60" y="-15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="24afdfdb-5b58-4413-9f4f-fee39123fb98" name="Validos" type="Data"><subsheetid>b34e7cf6-1e18-410c-b650-afeb1be644c8</subsheetid><display x="-75" y="-75" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="c8a30769-ffd6-43cb-9ed7-ec9d7003b061" name="Rechazados" type="Data"><subsheetid>b34e7cf6-1e18-410c-b650-afeb1be644c8</subsheetid><display x="165" y="-15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="cb6ebf15-473a-4b57-befc-9298cf73d39b" name="Duracion_Ms" type="Data"><subsheetid>b34e7cf6-1e18-410c-b650-afeb1be644c8</subsheetid><display x="-195" y="-15" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="bbda260f-e452-4c6c-93ef-a41100a2291a" name="Fecha_Corrida" type="Data"><subsheetid>b34e7cf6-1e18-410c-b650-afeb1be644c8</subsheetid><display x="240" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="5cb13b4a-dbb6-4db9-89a3-b432ecfeb29f" name="Resumen_Texto" type="Data"><subsheetid>b34e7cf6-1e18-410c-b650-afeb1be644c8</subsheetid><display x="165" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="e046efab-5452-4bc0-ac44-3af3dfacca18" name="Listar Archivos" type="Code"><subsheetid>0c93f424-84c9-4276-b176-c05b0703e567</subsheetid><loginhibit /><display x="0" y="-30" /><inputs><input type="text" name="Carpeta" expr="[Carpeta_Antrada]" /></inputs><outputs><output type="collection" name="archivos" stage="archivos" /><output type="number" name="Cantidad" stage="Cantidad" /><output type="number" name="Cantidad" stage="Cantidad" /><output type="number" name="Cantidad" stage="Cantidad" /></outputs><onsuccess>d642537d-6462-4e1a-9b46-b7ae176138b0</onsuccess><code><![CDATA[Dim dt As New System.Data.DataTable()
dt.Columns.Add("Nombre", GetType(String))
dt.Columns.Add("Ruta", GetType(String))
If System.IO.Directory.Exists(Carpeta) Then
    For Each f As String In System.IO.Directory.GetFiles(Carpeta, "*.xlsx")
        If Not System.IO.Path.GetFileName(f).StartsWith("~$") Then
            dt.Rows.Add(System.IO.Path.GetFileName(f), System.IO.Path.GetFullPath(f))
        End If
    Next
End If
archivos = dt
Cantidad = dt.Rows.Count]]></code></stage><stage stageid="d642537d-6462-4e1a-9b46-b7ae176138b0" name="End" type="End"><subsheetid>0c93f424-84c9-4276-b176-c05b0703e567</subsheetid><loginhibit /><display x="0" y="45" /><outputs><output type="collection" name="archivos" stage="archivos" /><output type="number" name="Cantidad" stage="Cantidad" /><output type="number" name="Cantidad" stage="Cantidad" /><output type="number" name="Cantidad" stage="Cantidad" /></outputs></stage><stage stageid="a1111111-1111-4111-8111-111111111111" name="Cantidad" type="Data"><subsheetid>0c93f424-84c9-4276-b176-c05b0703e567</subsheetid><display x="135" y="15" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="a1111111-1111-4111-8111-111111111111" name="Cantidad" type="Data"><subsheetid>0c93f424-84c9-4276-b176-c05b0703e567</subsheetid><display x="135" y="15" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage><stage stageid="a1111111-1111-4111-8111-111111111111" name="Cantidad" type="Data"><subsheetid>0c93f424-84c9-4276-b176-c05b0703e567</subsheetid><display x="135" y="15" /><datatype>number</datatype><initialvalue>0</initialvalue><private /><alwaysinit /></stage></process>